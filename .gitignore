# ---- Data (large, redistributable from source) ----
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
*.csv
*.parquet
*.pcap
*.pcapng

# ---- Model artifacts (reproducible from training scripts) ----
backend/artifacts/*
!backend/artifacts/.gitkeep
!backend/artifacts/README.md
*.pkl
*.pt
*.joblib

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Databases ----
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ---- Node ----
node_modules/
dist/
.vite/
*.tsbuildinfo

# ---- Env / secrets ----
.env
.env.local
.env.*.local
!.env.example

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Scratch ----
# Scratch working directory; never committed.
temp/

# ---- Logs ----
*.log
logs/

# ---- Documentation site build output ----
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/Gemfile.lock
docs/vendor/

# ---- The model release (Phase 8) ----
# One trained pair, its evaluation files and the demo flows are committed so a
# clean clone serves without the dataset (backend/app/release.py). Everything
# else a training run writes stays in backend/artifacts, ignored above.
!backend/release/
!backend/release/*.pkl
!backend/release/*.pt
!backend/release/*.parquet
