# ============================================================================
# Recluse — environment template
# Copy to .env (`make env`) and edit. .env is gitignored; this file is not.
# Nothing in the codebase hardcodes a path or a port: every value below is
# read through pydantic-settings (backend) or import.meta.env (frontend).
# ============================================================================

# ---- Runtime -----------------------------------------------------------
IDS_ENV=development                 # development | staging | production
IDS_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
IDS_HOST=127.0.0.1                  # 0.0.0.0 inside containers
IDS_PORT=8000
IDS_API_V1_PREFIX=/api/v1

# ---- Persistence -------------------------------------------------------
# SQLAlchemy URL. SQLite for local dev; swapping to Postgres is this line
# only -- the ORM models use portable column types exclusively.
#   postgresql+psycopg://ids:ids@localhost:5432/ids
IDS_DATABASE_URL=sqlite+pysqlite:///data/ids.db
IDS_DB_ECHO=false

# ---- Paths (relative paths resolve against the repo root) --------------
IDS_DATA_DIR=data
IDS_ARTIFACTS_DIR=backend/artifacts
IDS_REPORTS_DIR=reports
# The committed model release: one trained pair, its evaluation files and the
# demo flows. `make models` installs it into IDS_ARTIFACTS_DIR when nothing is
# serving there; a model you trained yourself is never overwritten.
IDS_RELEASE_DIR=backend/release

# ---- Browser clients allowed to call the API ---------------------------
IDS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- False-positive budget (Phase 2 threshold selection) ---------------
# max_alerts_per_day = ANALYST_CAPACITY_PER_HOUR * ANALYST_SHIFT_HOURS
# target_FPR         = max_alerts_per_day / EXPECTED_DAILY_FLOW_VOLUME
# Stated here so tau_sup is an engineering decision, not a default of 0.5.
IDS_EXPECTED_DAILY_FLOW_VOLUME=1000000
IDS_ANALYST_CAPACITY_PER_HOUR=40
IDS_ANALYST_SHIFT_HOURS=8

# ---- Alert pipeline ----------------------------------------------------
IDS_DEDUPE_WINDOW_SECONDS=300       # (src_host, alert_class, floor(ts, 5min))

# ---- Drift monitoring (Phase 7) ----------------------------------------
# Drift is measured over *scored traffic*, not over stored alerts. An alert is a
# row that crossed a threshold, so a PSI built from alerts answers "do the alerts
# look unusual" rather than "has the traffic moved" -- and the second question is
# the one a drift monitor exists to ask. So the pipeline keeps every Nth flow it
# scores, alerting or not, and the nightly job reads those.
#
# Systematic (every Nth) rather than random, so a replay produces the same sample
# twice and a drift number can be reproduced.
IDS_DRIFT_SAMPLE_STRIDE=500          # one flow in 500; 2,000/day at 1M flows/day
IDS_DRIFT_SAMPLE_KEEP=50000          # ~3 weeks at the stride above, then pruned
IDS_DRIFT_BINS=10                    # quantile bins per feature
IDS_DRIFT_WINDOW_HOURS=24            # how far back one run looks
IDS_DRIFT_MIN_ROWS=200               # below this, score nothing: PSI over a
                                     # handful of rows is noise, and a retrain
                                     # banner raised by noise is worse than none

# ---- Active learning (Phase 7) ----------------------------------------
# The poisoning guards on the autoencoder's benign refit pool. An attacker who
# can generate enough traffic and get it dismissed as a false positive can
# otherwise teach the baseline that their traffic is normal.
IDS_BENIGN_REFIT_HOST_CAP=0.2        # no source host above this share of the pool
IDS_BENIGN_REFIT_MIN_ROWS=200        # below this the baseline is left alone

# ---- Containment -------------------------------------------------------
# Hard off. The system alerts, ranks and explains; it never drops traffic.
# There is no value of this flag that enables automatic blocking.
IDS_ALLOW_AUTO_BLOCK=false

# ---- docker compose host port mapping ----------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---- Frontend (Vite; only VITE_* reaches the browser bundle) -----------
VITE_API_BASE_URL=/api/v1
VITE_DEV_SERVER_HOST=::                # dual-stack; 0.0.0.0 in containers
VITE_DEV_SERVER_PORT=5173
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
VITE_HEALTH_POLL_MS=5000
VITE_STATS_POLL_MS=10000            # aggregate panels; slower than health
VITE_REPLAY_POLL_MS=2000            # backs a control the analyst just clicked
VITE_THRESHOLD_DEBOUNCE_MS=150      # the threshold slider's request debounce
VITE_TICKER_ROWS=60                 # bounded, or a 100x replay grows it forever
VITE_QUEUE_PAGE_SIZE=100
