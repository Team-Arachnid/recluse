#!/bin/sh
# Publish wiki/ to the GitHub wiki after a commit that changed it.
#
# Installed by `python scripts/install_hooks.py` (or `make hooks`). Remove it
# with `python scripts/install_hooks.py --uninstall`.
#
# It runs only when the commit actually touched wiki/, and only on a branch
# listed in RECLUSE_WIKI_BRANCHES (default: main), because the GitHub wiki has
# no branches of its own — anything pushed to it is immediately live.
#
#   RECLUSE_SKIP_WIKI_PUBLISH=1 git commit ...   skip this hook once
#   RECLUSE_WIKI_BRANCHES="main develop"         publish from either branch
#
# A failure here never rewrites or undoes the commit; it only warns.

set -u

if [ "${RECLUSE_SKIP_WIKI_PUBLISH:-0}" = "1" ]; then
    exit 0
fi

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$repo_root" || exit 0

# Did this commit touch the wiki source? (--root covers the initial commit.)
if git diff-tree --no-commit-id --name-only -r --root HEAD | grep -q '^wiki/'; then
    :
else
    exit 0
fi

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
allowed=${RECLUSE_WIKI_BRANCHES:-main}
matched=0
for candidate in $allowed; do
    [ "$branch" = "$candidate" ] && matched=1
done

if [ "$matched" -eq 0 ]; then
    echo "[wiki] wiki/ changed on '$branch'; publishing only from: $allowed"
    echo "[wiki] run 'python scripts/publish_wiki.py' by hand to push anyway"
    exit 0
fi

python=$(command -v python3 || command -v python) || {
    echo "[wiki] python not found on PATH; skipping wiki publish"
    exit 0
}

echo "[wiki] wiki/ changed — publishing to the GitHub wiki"
"$python" scripts/publish_wiki.py || {
    echo "[wiki] publish failed. The commit is fine; re-run:"
    echo "[wiki]   python scripts/publish_wiki.py"
}

exit 0
